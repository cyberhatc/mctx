#!/usr/bin/env bash
# .mctx — mctx animated banner
# run:   ./.mctx
# or:    cat .mctx   (shows the intro, static)
# Ctrl+C to stop.

S=('|' '/' '-' '\')

clear
for i in $(seq 1 20); do
  tput cup 0 0
  printf '\x1b[1;33m  loading mctx\x1b[0m %s\n' "${S[i % 4]}"
  sleep 0.15
done
tput cup 1 0
printf '\x1b[1;32mmctx v2.1.3 ready\x1b[0m\n'
